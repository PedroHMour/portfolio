---
import Base from '../../layouts/Base.astro';
import { languages, ui, profile, type Lang } from '../../i18n/ui';
import { projects, stack } from '../../data/projects';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const wa = `https://wa.me/${profile.whatsapp}?text=${encodeURIComponent(t.contact.msg)}`;
const nav = [
  ['services', t.nav.services],
  ['process', t.nav.process],
  ['projects', t.nav.projects],
  ['stack', t.nav.stack],
  ['contact', t.nav.contact],
] as const;
---
<Base lang={lang}>
  <header class="sticky top-0 z-50 border-b border-line/60 bg-bg/80 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
      <a href="#top" class="font-extrabold tracking-tight">{profile.name}<span class="text-accent">.</span></a>
      <nav class="hidden gap-6 text-sm text-muted md:flex" aria-label="Principal">
        {nav.map(([id, label]) => <a href={`#${id}`} class="hover:text-fg">{label}</a>)}
      </nav>
      <div class="flex gap-1 text-xs font-semibold" aria-label="Language">
        {Object.keys(languages).map((l) => (
          <a
            href={`${base}/${l}/`}
            hreflang={l}
            aria-current={l === lang ? 'true' : undefined}
            class:list={['rounded-md px-2 py-1 uppercase', l === lang ? 'bg-accent text-bg' : 'text-muted hover:text-fg']}
          >{l}</a>
        ))}
      </div>
    </div>
  </header>

  <main id="top">
    <section class="section pt-16 md:pt-28">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs text-muted">
          <span class="size-2 rounded-full bg-accent-2"></span>{t.hero.badge}
        </span>
        <h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
          {t.hero.title} <span class="bg-gradient-to-r from-accent to-accent-2 bg-clip-text text-transparent">{t.hero.highlight}</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg text-muted">{t.hero.text}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={wa} target="_blank" rel="noopener" class="btn btn-primary">{t.hero.cta}</a>
          <a href={`${base}/cv.pdf`} download class="btn btn-ghost">{t.hero.cv}</a>
        </div>
      </div>
    </section>

    <section id="services" class="section">
      <h2 class="text-3xl font-extrabold">{t.services.title}</h2>
      <p class="mt-2 text-muted">{t.services.subtitle}</p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {t.services.items.map((s) => (
          <article class="card">
            <div class="text-3xl" aria-hidden="true">{s.icon}</div>
            <h3 class="mt-4 text-lg font-bold">{s.title}</h3>
            <p class="mt-2 text-sm text-muted">{s.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="process" class="section">
      <h2 class="text-3xl font-extrabold">{t.process.title}</h2>
      <p class="mt-2 text-muted">{t.process.subtitle}</p>
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {t.process.steps.map((s, i) => (
          <li class="card">
            <span class="text-sm font-bold text-accent">0{i + 1}</span>
            <h3 class="mt-2 text-lg font-bold">{s.title}</h3>
            <p class="mt-2 text-sm text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="projects" class="section">
      <h2 class="text-3xl font-extrabold">{t.projects.title}</h2>
      <p class="mt-2 text-muted">{t.projects.subtitle}</p>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {projects.map((p) => {
          const Tag = p.url ? 'a' : 'div';
          return (
            <Tag class="card block" {...(p.url ? { href: p.url, target: '_blank', rel: 'noopener' } : {})}>
              <h3 class="text-lg font-bold">{p.title}</h3>
              <p class="mt-2 text-sm text-muted">{p.description[lang]}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {p.tags.map((tag) => <li class="rounded-md bg-bg px-2 py-1 text-xs text-accent">{tag}</li>)}
              </ul>
              <p class="mt-4 text-xs font-semibold text-muted">{p.url ? `${t.projects.view} →` : t.projects.empty}</p>
            </Tag>
          );
        })}
      </div>
    </section>

    <section id="stack" class="section">
      <h2 class="text-3xl font-extrabold">{t.stack.title}</h2>
      <ul class="mt-8 flex flex-wrap gap-3">
        {stack.map((s) => <li class="rounded-full border border-line bg-surface px-4 py-2 text-sm">{s}</li>)}
      </ul>
    </section>

    <section id="contact" class="section">
      <div class="rounded-3xl border border-line bg-surface p-8 text-center sm:p-14">
        <h2 class="text-3xl font-extrabold sm:text-4xl">{t.contact.title}</h2>
        <p class="mx-auto mt-3 max-w-lg text-muted">{t.contact.text}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={wa} target="_blank" rel="noopener" class="btn btn-primary">{t.contact.whatsapp}</a>
          <a href={`mailto:${profile.email}`} class="btn btn-ghost">{t.contact.email}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-6 text-sm text-muted">
      <p>© {new Date().getFullYear()} {profile.name}. {t.footer}</p>
      <div class="flex gap-4">
        <a href={profile.github} target="_blank" rel="noopener" class="hover:text-fg">GitHub</a>
        <a href={profile.linkedin} target="_blank" rel="noopener" class="hover:text-fg">LinkedIn</a>
        <a href={profile.freelas99} target="_blank" rel="noopener" class="hover:text-fg">99Freelas</a>
      </div>
    </div>
  </footer>
</Base>
